<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>StepAssist</AssemblyName>
    <Version>1.1.0</Version>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <!-- point this at your game folder -->
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.steam/steam/steamapps/common/Block Story</GameDir>
    <Managed>$(GameDir)/blockstorylinux_Data/Managed</Managed>
  </PropertyGroup>
  <!-- Drop an icon.png in this folder and it's baked into your mod automatically, so the toolbox shows it
       in-game on the Mods card and your config header. No icon.png? The toolbox falls back to a letter badge. -->
  <ItemGroup Condition="Exists('icon.png')">
    <EmbeddedResource Include="icon.png"><LogicalName>icon.png</LogicalName></EmbeddedResource>
  </ItemGroup>
</Project>
